# Enforce LF line endings on all text/code/certificate files so SHA-256
# manifests match identically across Linux CI, WSL/Ubuntu, and Windows PowerShell.
* text=auto eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sha256 text eol=lf
*.lean text eol=lf
*.cmd text eol=crlf
*.npy binary
*.gz binary
*.pdf binary
*.zip binary
